{
  "name": "TeacherBag",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "web": "vite",
    "web:build": "vite build",
    "license-admin": "vite --config license-admin/vite.config.mts",
    "license-admin:build": "vite build --config license-admin/vite.config.mts",
    "typecheck:license-admin": "tsc -p license-admin/tsconfig.json --noEmit",
    "bundle:android": "cd android && gradlew bundleRelease",
    "bundle:android:ota": "cd android && gradlew bundleRelease -PenableOta=true",
    "apk:android": "cd android && gradlew assembleRelease",
    "apk:android:ota": "cd android && gradlew assembleRelease -PenableOta=true",
    "apk:android:ota:arm64": "cd android && gradlew assembleRelease -PenableOta=true -PreactNativeArchitectures=arm64-v8a",
    "apk:android:ota:armv7": "cd android && gradlew assembleRelease -PenableOta=true -PreactNativeArchitectures=armeabi-v7a",
    "bundle:admin-android": "cd android && gradlew bundleAdmin",
    "apk:admin-android": "cd android && gradlew assembleAdmin",
    "ota:publish": "node scripts/publish-ota.js",
    "ota:publish-apk": "node scripts/publish-ota-apk.js",
    "postinstall": "node scripts/patch_android_modules.js"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-voice/voice": "^3.2.4",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/drawer": "^7.13.8",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.87.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-pdf": "^7.0.4",
    "react-native-print": "^0.11.0",
    "react-native-reanimated": "^4.6.0-nightly-20260812-0f8cf6dcc",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-uuid": "^2.0.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.12.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "^15.1.3",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "postcss": "^8.5.26",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-react-native-web": "^2.7.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
